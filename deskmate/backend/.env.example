# 复制到 .env 后填写；密钥只在本地环境保存。运行时拒绝弱密钥和空密码。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus
LLM_FAST_MODEL=qwen-turbo
LLM_VL_MODEL=qwen-vl-plus
SEARCH_PROVIDER=llm_builtin
BOCHA_API_KEY=
EDGE_TOKEN=
JWT_SECRET=
ADMIN_PASSWORD=
DEMO_PASSWORD=
DEMO_MODE=true
DATABASE_URL=sqlite:///./data/deskmate.db
TZ=Asia/Shanghai
# 以下为 A 的现场环境变量，仅供接线参考，B 后端不会连接 HA 或小米云。
BACKEND_WS_URL=wss://<你的域名>/ws/edge
HA_URL=http://127.0.0.1:8123
HA_TOKEN=
MI_USER=
MI_PASS=
MI_PASS_TOKEN=
SPEAKER_HARDWARE=L05C
